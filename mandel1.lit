
function run()
{
    var leftedge   = 0-420;
    var rightedge  =  300;
    var topedge    =  300;
    var bottomedge = 0-300;
    var xstep      =    7;
    var ystep      =   15;
    var maxiter    =  500;
    var y0 = topedge;
    while(y0 > bottomedge)
    {
        var x0 = leftedge;
        while(x0 < rightedge)
        {
            var y = 0;
            var x = 0;
            var chcode = 32;
            var i = 0;
            while (i < maxiter)
            {
                var xx = (x * x) / 200;
                var yy = (y * y) / 200;
                if (xx + yy > 800)
                {
                    chcode = 48 + i;
                    if(i > 9)
                    {
                        chcode = 64;
                    }
                    i = maxiter;
                }
                y = (((x * y) / 100) + y0);
                x = ((xx - yy) + x0);
                i = i + 1;
            }
            var pch = chcode;
            //print("%c".format(chcode));
            if(chcode > 50)
            {
                pch = "+";
            }
            else if(chcode > 40)
            {
                pch = "-";
            }
            else if(chcode > 30)
            {
                pch = "@";
            }
            else
            {
                pch = "%";
            }
            print(pch);
            x0 = x0 + xstep;
        }
        print("\n");
        y0 = y0 - ystep;
    }
    return;
}


run();

