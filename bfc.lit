
/*
* optimizing brainfuck compiler. currently runs faster than the interpreter, but
* still MUCH MUCH MUCH slower than the C version.
* biggest issue is dictionary lookup; it's very inefficient atm.
* curiously, running this script with nodejs (./noderun.sh bfc.nn hanoi.bf) shows
* that even node, a tweaked out JITted monster of an interpreter, doesn't run
* any better either. so it seems that ...
*   either current dictionary optimizations (prefer string lookup without string copying) is
*   not actually quite good enough, or
*   that the silly, ad-hoc table impl from Lox really is kinda terrible.
*
* frankly, i'm tending toward the latter. the Table impl is just really primitive and
* not very good.
*/

const BFC_MAXMEMORY = 30000;

const OPCODE_MOVE = 1;
const OPCODE_ADD = 2;
const OPCODE_PRINTBYTE = 3;
const OPCODE_READBYTE = 4;
const OPCODE_JUMPIFFALSE = 5;
const OPCODE_JUMPIFTRUE = 6;

const FIELDTYPE_OPER = 0;
const FIELDTYPE_ARGUMENT = 1;

function getchar()
{
    return null;
}

class BFRunner
{
    constructor()
    {
        this.compiledcode = [];
    }

    /*
    * NB. the C version uses a fixed-size array for the bytecode;
    * in a language with dynamic arrays, that isn't needed, obviously.
    * so, compile() returns the array of bytecode.
    */
    compile(program, len)
    {
        var depth = 0;
        var c = -1;
        var sourcepos = 0;
        var destcount = 0;
        var destcode = [];
        while(sourcepos < len)
        {
            c = program[sourcepos];
            sourcepos++;
            if(c == ">" || c == "<")
            {
                if((destcount > 0) && (destcode[destcount - 1][FIELDTYPE_OPER] == OPCODE_MOVE))
                {
                    // NOTE: may be truncated on assignment to arg
                    // coalesce
                    var mval = -1;
                    if(c == ">")
                    {
                        mval = 1;
                    }
                    var idx1 = destcount - 1
                    var idx2 = FIELDTYPE_ARGUMENT;
                    destcode[idx1][idx2] += mval;
                }
                else
                {
                    var mval = -1;
                    if(c == ">")
                    {
                        mval = 1;
                    }
                    destcode.push([OPCODE_MOVE, mval])
                    destcount++;
                }
            }
            else if(c == "+" || c == "-")
            {
                if((destcount > 0) && (destcode[destcount - 1][FIELDTYPE_OPER] == OPCODE_ADD))
                {
                    // NOTE: may be truncated on assignment to arg
                    // coalesce
                    var mval = -1;
                    if(c == "+")
                    {
                        mval = 1;
                    }
                    destcode[destcount - 1][FIELDTYPE_ARGUMENT] += mval;
                }
                else
                {
                    var mval = -1;
                    if(c == "+")
                    {
                        mval = 1;
                    }
                    destcode.push([OPCODE_ADD, mval])
                    destcount++;
                }
            }
            else if(c == ".")
            {
                destcode.push([OPCODE_PRINTBYTE, 0])
                destcount++;
            }
            else if(c == ",")
            {
                destcode.push([OPCODE_READBYTE, 0])
                destcount++;
            }
            else if(c == "[")
            {
                destcode.push([OPCODE_JUMPIFFALSE, 0])
                destcount++;
            }
            else if(c == "]")
            {
                destcode.push([OPCODE_JUMPIFTRUE, 0])
                destcount++;
            }
        }
        println("compiled ", destcount, " instructions. now resolving jumps...")
        // Resolve all jumps
        var i = 0;
        while(i < destcount)
        {
            var tmpop = destcode[i][FIELDTYPE_OPER];
            if(tmpop == OPCODE_JUMPIFFALSE)
            {
                depth = 1;
                var target = i + 1;
                while((depth > 0) && (target < destcount))
                {
                    var nextop = destcode[target][FIELDTYPE_OPER];
                    target++;
                    if(nextop == OPCODE_JUMPIFFALSE)
                    {
                        depth++;
                    }
                    else if(nextop == OPCODE_JUMPIFTRUE)
                    {
                        depth-=1;
                    }
                }
                if(depth > 0)
                {
                    println("invalid program");
                    //return false;
                }
                destcode[i][FIELDTYPE_ARGUMENT] = target;
            }
            else if(tmpop == OPCODE_JUMPIFTRUE)
            {
                depth = 1;
                var target = i;
                while((depth > 0) && target >= 0)
                {
                    target-=1;
                    var nextop = destcode[target][FIELDTYPE_OPER];
                    if(nextop == OPCODE_JUMPIFTRUE)
                    {
                        depth++;
                    }
                    else if(nextop == OPCODE_JUMPIFFALSE)
                    {
                        depth-=1;
                    }
                }
                if(depth > 0)
                {
                    println("invalid program");
                    //return false;
                }
                destcode[i][FIELDTYPE_ARGUMENT] = target + 1;
            }
            i++;
        }
        println("finished compiling!")
        this.compiledcode = destcode
        return true;
    }

    // Run a compiled bytecode program.
    run()
    {
        var maxcodecount = this.compiledcode.length;
        var mem = Array(BFC_MAXMEMORY, 0)
        var datapos = 0;
        var codepos = 0;
        println("running ", maxcodecount, " instructions...")
        while(codepos < maxcodecount)
        {
            var arg = this.compiledcode[codepos][FIELDTYPE_ARGUMENT];
            var opc = this.compiledcode[codepos][FIELDTYPE_OPER];
            codepos  = codepos + 1;
            if(opc == OPCODE_MOVE)
            {
                datapos = (((datapos + arg) + BFC_MAXMEMORY) % BFC_MAXMEMORY);
            }
            else if(opc == OPCODE_ADD)
            {
                mem[datapos] += arg;
            }
            else if(opc == OPCODE_JUMPIFFALSE)
            {
                if(mem[datapos] > 0)
                {
                    codepos = codepos;
                }
                else
                {
                    codepos = arg;
                }
            }
            else if(opc == OPCODE_JUMPIFTRUE)
            {
                if(mem[datapos] > 0)
                {
                    codepos = arg;
                }
                else
                {
                    codepos = codepos;
                }
            }
            else if(opc == OPCODE_PRINTBYTE)
            {
                printchar(mem[datapos]);
            }
            else if(opc == OPCODE_READBYTE)
            {
                var c = getchar();
                if(c == null)
                {
                    mem[datapos] = 0;
                }
                else
                {
                    mem[datapos] = c;
                }
            }
        }
    }

    optoname(op)
    {
        if(op == OPCODE_MOVE)
        {
            return "move";
        }
        else if(op == OPCODE_ADD)
        {
            return "add";
        }
        else if(op == OPCODE_PRINTBYTE)
        {
            return "printbyte";
        }
        else if(op == OPCODE_READBYTE)
        {
            return "readbyte";
        }
        else if(op == OPCODE_JUMPIFFALSE)
        {
            return "jumpiffalse";
        }
        else if(op == OPCODE_JUMPIFTRUE)
        {
            return "jumpifnotzero";
        }
        return null;
    }

    printbc()
    {
        var i;
        var brline = 0;
        var len = this.compiledcode.length;
        print("compiled: ", len, " items: [\n");
        for(i=0; i<len; i++)
        {
            var nopt = this.compiledcode[i][FIELDTYPE_OPER];
            var arg = this.compiledcode[i][FIELDTYPE_ARGUMENT];
            var optn = this.optoname(nopt);
            print("", optn, "(", arg, ")");
            if((i+1) < len)
            {
                print(", ");
            }
            if(brline == 10)
            {
                println();
                brline = 0;
            }
            brline++;
        }
        print("\n]\n");
    }
}

function main()
{
    var src = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."
    var bfr = BFRunner()
    println("src=", src)
    if(!bfr.compile(src, src.length))
    {
        println("failed to compile program");
    }
    bfr.printbc();
    bfr.run();
}

main();

