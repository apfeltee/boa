 for(var key in items) { var val = items[key] 
response.write("\n                <tr>\n                    <td>\n                        ");
response.write( Response.htmlEncode(key) );
response.write("\n                    </td>\n                    <td>\n                        <em>\n                            ");
response.write( Response.htmlEncode(val) );
response.write("\n                        </em>\n                    </td>\n                </tr>\n            ");
 } 
response.write("\n            </tbody>\n        </ul>\n    </body>\n</html>");

