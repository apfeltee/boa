var y = 0
var x = 0
for(var y = -1.0; y < 1.0; y = y + 0.05)
{
    for(var x = -2.0; x < 1.0; x = x + 0.03)
    {
        var u = 0.0;
        var v = 0.0;
        var u2 = u * u;
        var v2 = v * v;
        var k = 0
        for(k = 1; k < 100 && u2 + v2 < 4.0; k++)
        {
            v = 2.0 * u * v + y;
            u = u2 - v2 + x;
            u2 = u * u;
            v2 = v * v;
        }
        if(k < 40)
        {
            var bc = (k % 10);
            var chr = "!";
            if(bc == 2){ chr = "-" }
            else if(bc == 3){ chr = "+" }
            else if(bc == 4){ chr = "/" }
            else if(bc == 5){ chr = "*" }
            else if(bc == 6){ chr = "%" }
            else if(bc == 1){ chr = "~" }
            else if(bc == 9){ chr = ";" }
            else if(bc == 8){ chr = "?" }
            else if(bc == 0){ chr = "=" }
            else if(bc == 7){ chr = "&" }
            print(chr);
        }
        else
        {
            print("#");
        }
    }
    println();
}

