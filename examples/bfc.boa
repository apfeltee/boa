
/*
* optimizing brainfuck compiler. currently runs faster than the interpreter, but
* still MUCH MUCH MUCH slower than the C version.
* biggest issue is dictionary lookup; it's very inefficient atm.
* curiously, running this script with nodejs (./noderun.sh bfc.nn hanoi.bf) shows
* that even node, a tweaked out JITted monster of an interpreter, doesn't run
* any better either. so it seems that ...
*   either current dictionary optimizations (prefer string lookup without string copying) is
*   not actually quite good enough, or
*   that the silly, ad-hoc table impl from Lox really is kinda terrible.
*
* frankly, i'm tending toward the latter. the Table impl is just really primitive and
* not very good.
*/


OP_MOVE = 1;
OP_ADD = 2;
OP_PRINTBYTE = 3;
OP_READBYTE = 4;
OP_JUMPIFFALSE = 5;
OP_JUMPIFTRUE = 6;

FIELD_OPER = 0;
FIELD_ARGUMENT = 1;

function makefilledarray(cnt, val)
{
    var i;
    var rt = [];
    for(i=0; i<cnt; i++)
    {
        rt.push(val);
    }
    return rt;
}

function getchar()
{
    return -1;
}

/*
* NB. the C version uses a fixed-size array for the bytecode;
* in a language with dynamic arrays, that isn't needed, obviously.
* so, compile() returns the array of bytecode.
*/
function compilecode(program, len, toscript)
{
    var depth;
    var target;
    var c;
    var i;
    var mval;
    var tmpop;
    var nextop;
    var pvop;
    var finalcode = [];
    var comcount = 0;
    var sourcepos = 0;
    while(sourcepos < len)
    {
        c = program[sourcepos];
        sourcepos++;
        if(c == '>' || c == '<')
        {
            if((comcount > 0) && (finalcode[comcount - 1][FIELD_OPER] == OP_MOVE))
            {
                // NOTE: may be truncated on assignment to arg
                // coalesce
                mval = -1;
                if(c == '>')
                {
                    mval = 1;
                }
                finalcode[comcount - 1][FIELD_ARGUMENT] += mval;
            }
            else
            {
                pvop = OP_MOVE;
                mval = -1;
                if(c == '>')
                {
                    mval = 1;
                }
                finalcode.push([OP_MOVE, mval])
                comcount++;
            }
        }
        else if(c == '+' || c == '-')
        {
            if((comcount > 0) && (finalcode[comcount - 1][FIELD_OPER] == OP_ADD))
            {
                // NOTE: may be truncated on assignment to arg
                // coalesce
                mval = -1;
                if(c == '+')
                {
                    mval = 1;
                }
                finalcode[comcount - 1][FIELD_ARGUMENT] += mval;
            }
            else
            {
                mval = -1;
                if(c == '+')
                {
                    mval = 1;
                }
                finalcode.push([OP_ADD, mval])
                comcount++;
            }
        }
        else if(c == '.')
        {
            finalcode.push([OP_PRINTBYTE, 0])
            comcount++;
        }
        else if(c == ',')
        {
            finalcode.push([OP_READBYTE, 0])
            comcount++;
        }
        else if(c == '[')
        {
            finalcode.push([OP_JUMPIFFALSE, 0])
            comcount++;
        }
        else if(c == ']')
        {
            finalcode.push([OP_JUMPIFTRUE, 0])
            comcount++;
        }
    }
    println("compiled ", comcount, " instructions. now resolving jumps...")
    // Resolve all jumps
    for(i = 0; i < comcount; i++)
    {
        tmpop = finalcode[i][FIELD_OPER];
        if(tmpop == OP_JUMPIFFALSE)
        {
            depth = 1;
            target = i + 1;
            while((depth > 0) && (target < comcount))
            {
                nextop = finalcode[target][FIELD_OPER];
                target++;
                if(nextop == OP_JUMPIFFALSE)
                {
                    depth++;
                }
                else if(nextop == OP_JUMPIFTRUE)
                {
                    depth--;
                }
            }
            if(depth > 0)
            {
                // invalid program
                return null;
            }
            finalcode[i][FIELD_ARGUMENT] = target;
        }
        else if(tmpop == OP_JUMPIFTRUE)
        {
            depth = 1;
            target = i;
            while((depth > 0) && target >= 0)
            {
                target--;
                nextop = finalcode[target][FIELD_OPER];
                if(nextop == OP_JUMPIFTRUE)
                {
                    depth++;
                }
                else if(nextop == OP_JUMPIFFALSE)
                {
                    depth--;
                }
            }
            if(depth > 0)
            {
                // invalid program
                return null;
            }
            finalcode[i][FIELD_ARGUMENT] = target + 1;
        }
    }
    if(toscript)
    {
        println("compiling to boa ... ")
        var csrc = [];
        /*
            OP_MOVE = 1;
            OP_ADD = 2;
            OP_PRINTBYTE = 3;
            OP_READBYTE = 4;
            OP_JUMPIFFALSE = 5;
            OP_JUMPIFTRUE = 6;
        
        */
        var iter = 0;
        var maxcodecount = finalcode.length;
        csrc.push(`var arg = 0`)
        csrc.push(`var m_codepos = 0`)
        csrc.push(`var m_datapos = 0`)
        csrc.push(`var m_memory = Array(300000, 0)`)
        while(iter < maxcodecount)
        {
            var arg = finalcode[iter][FIELD_ARGUMENT];
            var opc = finalcode[iter][FIELD_OPER];
            csrc.push(`arg = ${arg}`)
            iter += 1;
            if(opc == OP_MOVE)
            {
                csrc.push(`m_datapos = ((m_datapos + arg) + 30000) % 30000`)
                //iter = ((iter + arg) + 30000) % 30000
            }
            else if(opc == OP_ADD)
            {
                csrc.push(`m_memory[m_datapos] += arg`)
            }
            else if(opc == OP_JUMPIFFALSE)
            {
                csrc.push(`
                if(m_memory[m_datapos] > 0)
                {
                    m_codepos = m_codepos;
                }
                else
                {
                    m_codepos = arg;
                }`)
                iter = arg
            }
            else if(opc == OP_JUMPIFTRUE)
            {
                csrc.push(`
                if(m_memory[m_datapos] > 0)
                {
                    m_codepos = arg;
                }
                else
                {
                    m_codepos = m_codepos;
                }
                `)
            }
            else if(opc == OP_PRINTBYTE)
            {
                csrc.push(`printchar(m_memory[m_datapos])`)
            }
            else if(opc == OP_READBYTE)
            {
                //STDOUT.flush()
                csrc.push(`var c = STDIN.readChar()`)
                csrc.push(`m_memory[m_datapos] = c`)
            }
        }
        println("finished compiling!")
        return csrc;
    }
    println("finished compiling!")
    return finalcode;
}


// Run a compiled bytecode program.
function runbc(bcode)
{
    var datapos;
    var codepos;
    var maxcodecount = bcode.length;
    var mem = Array(300000, 0)
    //var mem = []
    datapos = 0;
    codepos = 0;
    println("running ", maxcodecount, " instructions...")
    while(codepos < maxcodecount)
    {
        var arg = bcode[codepos][FIELD_ARGUMENT];
        var opc = bcode[codepos][FIELD_OPER];
        codepos++;
        if(opc == OP_MOVE)
        {
            datapos = ((datapos + arg) + 30000) % 30000;
        }
        else if(opc == OP_ADD)
        {
            mem[datapos] += arg;
        }
        else if(opc == OP_JUMPIFFALSE)
        {
            if(mem[datapos] > 0)
            {
                codepos = codepos;
            }
            else
            {
                codepos = arg;
            }
        }
        else if(opc == OP_JUMPIFTRUE)
        {
            if(mem[datapos] > 0)
            {
                codepos = arg;
            }
            else
            {
                codepos = codepos;
            }
        }
        else if(opc == OP_PRINTBYTE)
        {
            printchar(mem[datapos]);
        }
        else if(opc == OP_READBYTE)
        {
            //STDOUT.flush()
            var c = getchar();
            if(c == null)
            {
                mem[datapos] = 0;
            }
            else
            {
                mem[datapos] = c;
            }
        }
    }
}

function runcode(bc)
{
    eval(bc.join(";"))
}

function run(bc, toscript)
{
    if(toscript)
    {
        return runcode(bc);
    }
    return runbc(bc);
}

function optoname(op)
{
    if(op == OP_MOVE)
    {
        return "move";
    }
    else if(op == OP_ADD)
    {
        return "add";
    }
    else if(op == OP_PRINTBYTE)
    {
        return "printbyte";
    }
    else if(op == OP_READBYTE)
    {
        return "readbyte";
    }
    else if(op == OP_JUMPIFFALSE)
    {
        return "jumpiffalse";
    }
    else if(op == OP_JUMPIFTRUE)
    {
        return "jumpifnotzero";
    }
    return null;
}

function printcodebc(bcode)
{
    var brline = 0;
    var len = bcode.length;
    print("count: ", len, " items: [\n");
    for(i=0; i<len; i++)
    {
        var nopt = bcode[i][FIELD_OPER];
        var arg = bcode[i][FIELD_ARGUMENT];
        var optn = optoname(nopt);
        print("", optn, "(", arg, ")");
        if((i+1) < len)
        {
            print(", ");
        }
        if(brline == 10)
        {
            println();
            brline = 0;
        }
        brline++;
    }
    print("\n]\n");
}

function printcodescript(bcode)
{
    var destfilename = "btmp.boa"
    var len = bcode.length;
    print("count: ", len, " writing to ", destfilename, "\n");
    var fh = File(destfilename, "wb")
    for(var itm in bcode)
    {
        fh.write(itm)
        fh.write(";\n")
    }
    fh.close()
}

function printcode(bc, toscript)
{
    if(toscript)
    {
        return printcodescript(bc);
    }
    return printcodebc(bc);
}

function getargv(i)
{
    if(typeof(ARGV) == "undefined")
    {
        var sa = eval("scriptArgs");
        if(typeof(sa) == "undefined")
        {
            println("process.argv=", process.argv)
            return process.argv[i + 1]
        }
        return sa[i + 1];
    }
    return ARGV[i];
}

function readfile(path)
{
    if(typeof(ARGV) == "array")
    {
        return File.read(path)
    }
    var fs=require("fs");
    return fs.readFileSync(path).toString();
}

function main()
{
    var src = null;
    var fpath = null;
    var toscript = false;
    var first = getargv(1);
    if(first)
    {
        if(first[0] == "-")
        {
            fpath = getargv(2);
            if(first == "-n")
            {
                toscript = true;
            }
        }
        else
        {
            fpath = first;
        }
    }
    src = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++."
    println("fpath=", fpath)
    if(fpath != null)
    {
        src = readfile(fpath)
    }
    println("src=", src)
    var code = compilecode(src, src.length, toscript);
    if(!code)
    {
        println("failed to parse program");
    }
    printcode(code, toscript);
    if(toscript)
    {
        println("run btmp.boa!")
    }
    else
    {
        run(code, toscript);
    }
}

main()
