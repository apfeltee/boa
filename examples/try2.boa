try
{
    try
    {
        throw Exception("Second exception thrown")
    }
    catch(e)
    {
        println(`inner: (${e.class.name})  ${e.message} at ${e.srcline}`);
    }
}
catch(e)
{
    println(`outer: ${e.message}`);
}

try
{
    var i = 10
    println(i)
    try
    {
        println({}[10]())
    }
    catch(e)
    {
        println(`\nMessage: ${e.message}`)
    }
    finally
    {
        println("Despite the error, I run because I am in finally")
    }
}
catch(e)
{
    println(e)
}

try
{
    throw Exception("I am a thrown exception")
    throw Exception("Second exception we will never reach")
}
catch(e)
{
    println("\nCatching exception...")
    println(`Exception message: ${e.message}`)
    //println(`Exception trace: ${e.stacktrace}`)
}

try
{
    println("\nTry block called")
}
finally
{
    println("Final block called\n")
}

try
{
    println(Math/["10"])
}
catch(e)
{
    print("past finally: ", e.message, "\n")
}
finally
{
    println("Error occurred, but I will still run")
}

println("all good")
