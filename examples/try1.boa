try
{
    try
    {
        throw Exception("Second exception thrown")
    }
    catch(e)
    {
        println(`inner:  ${e.message}`);
    }
}
catch(e)
{
    println(`outer: ${e}`);
}

try
{
    var i = 10
    println(i)
    try
    {
        println(Math / null)
    }
    catch(e)
    {
        println(`\nMessage: ${e}`)
    }
    finally
    {
        println("Despite the error, I run because I am in finally")
    }
}
catch(e)
{
    println(e)
}

try
{
    throw Exception("I am a thrown exception")
    throw Exception("Second exception we will never reach")
}
catch(e)
{
    println("\nCatching exception...")
    println(`Exception message: ${e}`)
}

try
{
    println("\nTry block called")
}
finally
{
    println("Final block called\n")
}

try
{
    println([] / null)
}
catch(e)
{
    print("past finally: ", e, "\n")
}
finally
{
    println("Error occurred, but I will still run")
}

println("all good")
