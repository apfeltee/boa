



const DEFAULT_HEIGHT = 8
const DEFAULT_WIDTH = 16
const MB_CUR_MAX = 1

const NORTH = 1
const SOUTH = 2
const WEST = 4
const EAST = 8
const SOLVE = 16
const RAND_MAX = 2147483647

var g_cell;
var g_width;
var g_height;
var g_avail;

var dirs = [ [ -2, 0 ], [ 0, 2 ], [ 2, 0 ], [ 0, -2 ] ]

/*
const wchar_t glyph[] = L" │││─┘┐┤─└┌├─┴┬┼ ┆┆┆┄╯╮ ┄╰╭ ┄";
*/

const glyph = [ 32,   9474, 9474, 9474, 9472, 9496, 9488, 9508, 9472, 9492, 9484, 9500, 9472, 9524, 9516,
                             9532, 32,   9478, 9478, 9478, 9476, 9583, 9582, 32,   9476, 9584, 9581, 32,   9476 ];

function IS_CODEUNIT(c)
{
    return ((c - 0xdf80) < 0x80);
}

function custom_wcrtomb(wc, st)
{
    var destbuf = [];
    if(wc < 0x80)
    {
        destbuf.push(wc);
        return destbuf;
    }
    else if(wc < 0x800)
    {
        destbuf.push(0xc0 | (wc >> 6));
        destbuf.push(0x80 | (wc & 0x3f));
        return destbuf;
    }
    else if(wc < 0xd800 || wc - 0xe000 < 0x2000)
    {
        destbuf.push(0xe0 | (wc >> 12));
        destbuf.push(0x80 | ((wc >> 6) & 0x3f));
        destbuf.push(0x80 | (wc & 0x3f));
        return destbuf;
    }
    else if(wc - 0x10000 < 0x100000)
    {
        destbuf.push(0xf0 | (wc >> 18));
        destbuf.push(0x80 | ((wc >> 12) & 0x3f));
        destbuf.push(0x80 | ((wc >> 6) & 0x3f));
        destbuf.push(0x80 | (wc & 0x3f));
        return destbuf;
    }
    return destbuf;
}

function custom_wctomb(wc)
{
    return custom_wcrtomb(wc, 0);
}

function putglyph(wc)
{
    var i;
    var rt;
    var buf;
    if(wc > -1)
    {
        buf = custom_wctomb(wc);
        rt = buf.length
        for(i = 0; i < rt; i++)
        {
            printchar(buf[i], f);
        }
    }
    return -1;
}

// http://www.concentric.net/~Ttwang/tech/inthash.htm
function mix(a, b, c)
{
    a = a - b;
    a = a - c;
    a = a ^ (c >> 13);
    b = b - c;
    b = b - a;
    b = b ^ (a << 8);
    c = c - a;
    c = c - b;
    c = c ^ (b >> 13);
    a = a - b;
    a = a - c;
    a = a ^ (c >> 12);
    b = b - c;
    b = b - a;
    b = b ^ (a << 16);
    c = c - a;
    c = c - b;
    c = c ^ (b >> 5);
    a = a - b;
    a = a - c;
    a = a ^ (c >> 3);
    b = b - c;
    b = b - a;
    b = b ^ (a << 10);
    c = c - a;
    c = c - b;
    c = c ^ (b >> 15);
    return c;
}

function irand(n)
{
    var r;
    var rmax;
    rmax = n * (RAND_MAX / n);
    while((r = random()) >= rmax)
    {
    }
    return r / (RAND_MAX / n);
}

function show()
{
    var i;
    var j;
    var c;
    for(i = 0; i <= 2 * g_height; i++)
    {
        for(j = 0; j <= 2 * g_width; j++)
        {
            c = g_cell[i][j];
            if(c > SOLVE)
            {
                print("\033[31m");
            }
            //printf("%lc", glyph[c]);
            putglyph(glyph[c]);
            if(c > SOLVE)
            {
                print("\033[m");
            }
        }
        println();
    }
}

function walk(x, y)
{
    var i;
    var t;
    var x1;
    var y1;
    var d = [ 0, 1, 2, 3 ];
    g_cell[y][x] |= SOLVE;
    g_avail--;
    for(x1 = 3; x1; x1--)
    {
        if(x1 != (y1 = irand(x1 + 1)))
        {
            i = d[x1];
            d[x1] = d[y1];
            d[y1] = i;
        }
    }
    for(i = 0; g_avail && i < 4; i++)
    {
        x1 = x + dirs[d[i]][0];
        y1 = y + dirs[d[i]][1];
        if(g_cell[y1][x1] & SOLVE)
        {
            continue;
        }
        if(x1 == x)
        {
            t = (y + y1) / 2;
            g_cell[t][x + 1] &= ~WEST;
            g_cell[t][x] &= ~(EAST | WEST);
            g_cell[t][x - 1] &= ~EAST;
        }
        else if(y1 == y)
        {
            t = (x + x1) / 2;
            g_cell[y - 1][t] &= ~SOUTH;
            g_cell[y][t] &= ~(NORTH | SOUTH);
            g_cell[y + 1][t] &= ~NORTH;
        }
        walk(x1, y1);
    }
}
function solve(x, y, tox, toy)
{
    var i;
    var t;
    var x1;
    var y1;
    g_cell[y][x] |= SOLVE;
    if(x == tox && y == toy)
    {
        return 1;
    }
    for(i = 0; i <= 3; i++)
    {
        x1 = x + dirs[i][0];
        y1 = y + dirs[i][1];
        if(g_cell[y1][x1])
        {
            continue;
        }
        if(x1 == x)
        {
            t = (y + y1) / 2;
            if(g_cell[t][x] || !solve(x1, y1, tox, toy))
            {
                continue;
            }
            g_cell[t - 1][x] |= SOUTH;
            g_cell[t][x] |= SOLVE | NORTH | SOUTH;
            g_cell[t + 1][x] |= NORTH;
        }
        else if(y1 == y)
        {
            t = (x + x1) / 2;
            if(g_cell[y][t] || !solve(x1, y1, tox, toy))
            {
                continue;
            }
            g_cell[y][t - 1] |= EAST;
            g_cell[y][t] |= SOLVE | EAST | WEST;
            g_cell[y][t + 1] |= WEST;
        }
        return 1;
    }
    g_cell[y][x] &= ~SOLVE;
    return 0;
}

function make_maze()
{
    var i;
    var j;
    var h2;
    var w2;
    var p;
    w2 = 2 * g_width + 2;
    h2 = 2 * g_height + 2;
    var vhigh = (h2 + 2) + 1
    var vlow = (w2 * h2) + 1
    println(`vhigh=${vhigh}, vlow=${vlow}`)
    p = Array(vhigh, Array(vhigh, 0)) 

    


    p[1] = p[h2 + 2][1];
    
    for(i = 2; i <= h2; i++)
    {
        p[i] = p[i - 1] + w2;
    }

    println("here...? p = ", p)


    p[0] = p[h2];
    g_cell = p[1];
    for(i = -1; i <= 2 * g_height + 1; i++)
    {
        g_cell[i][-1] = SOLVE
        g_cell[i][w2 - 1] = SOLVE;
    }
    for(j = 0; j <= 2 * g_width; j++)
    {
        g_cell[-1][j] = g_cell[h2 - 1][j] = SOLVE;
    }
    for(i = 0; i <= g_height; i++)
    {
        for(j = 0; j <= 2 * g_width; j++)
        {
            g_cell[2 * i][j] |= EAST | WEST;
        }
    }
    for(i = 0; i <= 2 * g_height; i++)
    {
        for(j = 0; j <= g_width; j++)
        {
            g_cell[i][2 * j] |= NORTH | SOUTH;
        }
    }
    for(j = 0; j <= 2 * g_width; j++)
    {
        g_cell[0][j] &= ~NORTH;
        g_cell[2 * g_height][j] &= ~SOUTH;
    }
    for(i = 0; i <= 2 * g_height; i++)
    {
        g_cell[i][0] &= ~WEST;
        g_cell[i][2 * g_width] &= ~EAST;
    }
    g_avail = g_width * g_height;
    walk(irand(2) * 2 + 1, irand(g_height) * 2 + 1);
    for(i = 0; i <= 2 * g_height; i++)
    {
        for(j = 0; j <= 2 * g_width; j++)
        {
            g_cell[i][j] &= ~SOLVE;
        }
    }
    solve(1, 1, 2 * g_width - 1, 2 * g_height - 1);
    show();
}

function main()
{
    var fa;
    var argv = ARGV
    var argc = argv.length
    g_width = DEFAULT_WIDTH;
    g_height = DEFAULT_HEIGHT;
    srand(mix(time(), systemTime(), 0x37001));
    make_maze();
    return 0;
}


main()

