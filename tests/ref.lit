var a = "Test"
println(@a) // Expected: Test

g = 10
println(@g) // Expected: 10

function test() {
	var a = 32
	println(@a) // Expected: 32
	a = 90

	return () => {
		println(@a) // Expected: 90
	}
}

test()()

var z = {
	me: "Egor"
}

println(@z.me) // Expected: Egor

function change(a) {
	@a = "Test"
}

change(@z.me)
println(z.me) // Expected: Test