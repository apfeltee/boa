var a = 32

println((a += 2)) // Expected: 34
println((a -= 2)) // Expected: 32
println((a *= 2)) // Expected: 64
println((a /= 4)) // Expected: 16

println((a++)) // Expected: 17
println((a--)) // Expected: 16

println((a %= 3)) // Expected: 1

println(a |= 3) // Expected: 3
println(a &= 10) // Expected: 2
println(a ^= 31) // Expected: 29

class Test {}
var test = Test()
test.a = 32

println(test.a += 32) // Expected: 64
println(test.a #= 3) // Expected: 21