class Test {
	constructor() {
		this.base = 1
		this.array = [ 1, 2, 3 ]
	}

	operator + (value) {
		return this.base + value
	}

	operator - (value) {
		return this.base - value
	}

	operator * (value) {
		return this.base * value
	}

	operator / (value) {
		return this.base / value
	}

	operator % (value) {
		return this.base % value
	}

	operator > (value) {
		return this.base > value
	}

	operator >= (value) {
		return this.base >= value
	}

	operator < (value) {
		return this.base < value
	}

	operator <= (value) {
		return this.base <= value
	}

	operator ! (value) {
		return true
	}

	operator [] (index, value) {
		if (value != null) {
			this.array[index] = value
		} else {
			return this.array[index]
		}
	}

	operator == (value) {
		return this.base == value
	}
}

var t = new Test()

println(t + 3) // Expected: 4
println(t - 3) // Expected: -2
println(t * 3) // Expected: 3
println(t / 2) // Expected: 0.5
println(t % 2) // Expected: 1
println(t > 1) // Expected: false
println(t >= 1) // Expected: true
println(t < 1) // Expected: false
println(t <= 1) // Expected: true
println(t[2]) // Expected: 3
t[2] = 4
println(t[2]) // Expected: 4
println(t == 1) // Expected: true
println(t == 2) // Expected: false
println(!t) // Expected: true