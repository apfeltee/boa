println(1 + 3) // Expected: 4
println(1 - 3) // Expected: -2
println(2 * 3) // Expected: 6
println(9 / 3) // Expected: 3
println(10 # 3) // Expected: 3
println(4 % 2) // Expected: 0
println(3 ** 2) // Expected: 9
println(1 << 2) // Expected: 4
println(4 >> 1) // Expected: 2
println(3 ^ 4) // Expected: 7
println(~45) // Expected: -46
println(128 | 39) // Expected: 167
println(69 & 420) // Expected: 4

println(2 + 2 * 2) // Expected: 6

println(true || true) // Expected: true
println(false || true) // Expected: true
println(true || false) // Expected: true
println(false || false) // Expected: false

println(true && true) // Expected: true
println(false && true) // Expected: false
println(true && false) // Expected: false
println(false && false) // Expected: false

println(null ?? true) // Expected: true
println(10 ?? true) // Expected: 10
println(null ?? null) // Expected: null

println("test" is String) // Expected: true
println("test" is Object) // Expected: true
println("test" is Number) // Expected: false

println(32 is Number) // Expected: true
println(32 is Object) // Expected: true

println(true is Bool) // Expected: true
println(true is Object) // Expected: true

println(() => {} is Function) // Expected: true

// We have to export it or it will get optimized out
export function a() {}

println(a is Function) // Expected: true
println(a is Object) // Expected: true

class Test {

}

println(Test is Class) // Expected: true
println(Test is Object) // Expected: false

println([] is Array) // Expected: true
println([] is Object) // Expected: true