


function calcpoint(cx, cy, maxit)
{
    var i = 0;
    var xp = 0;
    var yp = 0;
    while (i < maxit)
    {
        var t = (((xp * xp) - (yp * yp)) + cx);
        yp = (((2 * xp) * yp) + cy);
        xp = t;
        if(((xp * xp) + (yp * yp)) > 4)
        {
            break;
        }
        i++;
    }
    return i;
}

function mandelbrot(x1,y1, x2,y2, sizex,sizey, maxiter)
{
    var stepx = (x2-x1)/(sizex-1);
    var stepy = (y2-y1)/(sizey-1);
    var py = y1;
    var ec = "\e";
    while (py <= y2) {
        var x = x1;
        while (x <= x2) {
            var c = calcpoint(x, py, maxiter);
            if (c == maxiter) {
                print(ec, "[37;40m ");
            } else {
                var bc = ((c % 6) + 1);
                print(ec, "[37;4", bc, "m ");
            }
            x += stepx;
        }
        py += stepy;
        print(ec, "[0m", "\n");
    }
}

function doit()
{
    var lines = 40 - 1;
    var cols = (2.2 * lines);
    println("lines=", lines, ", cols=", cols);
    mandelbrot((0 - 2), (0 - 2), 2, 2, cols, lines, 100);
}

doit();
